---
import { t, type Locale } from '../lib/locale';

interface Props {
  date: string;
  location?: string;
  readingMinutes?: number;
  locale?: Locale;
  class?: string;
}

const { date, location, readingMinutes, locale = 'zh', class: className } = Astro.props;
const ui = t(locale);
---

<div class:list={['flex flex-wrap items-center gap-2', className]}>
  <span class="metal-plate">{date}</span>
  {
    location && (
      <span class="inline-flex items-center gap-1 font-ui text-xs font-semibold text-ink-muted border border-line rounded-small px-2 py-0.5 bg-paper">
        <span aria-hidden="true">⌖</span>
        {location}
      </span>
    )
  }
  {
    readingMinutes != null && (
      <span class="font-ui text-xs text-ink-muted">{readingMinutes} {ui.notes.readingTime}</span>
    )
  }
</div>
