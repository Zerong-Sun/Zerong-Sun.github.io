---
import type { CollectionEntry } from 'astro:content';
import CategoryBadge from './CategoryBadge.astro';
import DatePlate from './DatePlate.astro';
import { formatDate, readingTime } from '../lib/notes';
import type { Locale } from '../lib/locale';

interface Props {
  note: CollectionEntry<'notes'>;
  variant?: 'wood' | 'sign' | 'paper';
  featured?: boolean;
  body?: string;
  locale?: Locale;
}

const { note, variant = 'wood', featured = false, body = '', locale = 'zh' } = Astro.props;
const tag = note.data.tags[0] ?? note.data.category ?? 'note';
const mins = readingTime(body || note.data.description || note.data.title);
const dateStr = formatDate(note.data.date, locale);

const variantClass =
  variant === 'sign'
    ? 'card-irregular card-irregular--sign'
    : variant === 'paper'
      ? 'card-irregular card-irregular--paper'
      : 'card-irregular card-irregular--wood';

const noteHref = locale === 'en' ? `/en/notes/${note.slug}/` : `/notes/${note.slug}/`;
---

<article
  class:list={[variantClass, 'overflow-hidden h-full flex flex-col', featured && 'min-h-[280px]']}
  data-assemble
>
  <a href={noteHref} class="flex flex-col h-full p-4 md:p-5 group">
    <div class="flex items-start justify-between gap-2 mb-3">
      {
        note.data.category ? (
          <CategoryBadge category={note.data.category} locale={locale} />
        ) : (
          note.data.tags[0] && <CategoryBadge tag={note.data.tags[0]} locale={locale} />
        )
      }
      <span class="staple-mark" aria-hidden="true" />
    </div>

    {
      note.data.image && (
        <div class="mb-3 overflow-hidden border-2 border-ink/80 rounded-small bg-board">
          <img
            src={note.data.image}
            alt=""
            class:list={[
              'w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]',
              featured ? 'aspect-[3/2]' : 'aspect-[4/3]',
            ]}
            loading="lazy"
          />
        </div>
      )
    }

    <h3
      class:list={[
        'font-display font-semibold leading-snug mb-2 group-hover:hand-underline line-clamp-2',
        featured ? 'text-xl md:text-2xl' : 'text-lg',
        variant === 'sign' && 'text-white',
      ]}
    >
      {note.data.title}
    </h3>

    {
      note.data.description && (
        <p
          class:list={[
            'text-sm leading-relaxed mb-4 flex-1 line-clamp-3',
            variant === 'sign' ? 'text-white/85' : 'text-ink-muted',
          ]}
        >
          {note.data.description}
        </p>
      )
    }

    <DatePlate date={dateStr} location={note.data.location} readingMinutes={mins} locale={locale} />
  </a>
</article>
