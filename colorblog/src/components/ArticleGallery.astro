---
interface Props {
  images: { src: string; alt?: string; caption?: string }[];
  layout?: 'grid' | 'diptych' | 'strip';
}

const { images, layout = 'grid' } = Astro.props;
---

{
  layout === 'diptych' && images.length >= 2 ? (
    <div class="grid md:grid-cols-2 gap-3 my-8">
      {images.slice(0, 2).map((img) => (
        <figure class="img-framed">
          <img src={img.src} alt={img.alt ?? ''} loading="lazy" />
          {img.caption && <figcaption class="img-caption px-1">{img.caption}</figcaption>}
        </figure>
      ))}
    </div>
  ) : layout === 'strip' ? (
    <div class="flex gap-3 overflow-x-auto my-8 pb-2">
      {images.map((img) => (
        <figure class="img-framed shrink-0 w-64">
          <img src={img.src} alt={img.alt ?? ''} class="aspect-[3/2] object-cover" loading="lazy" />
          {img.caption && <figcaption class="img-caption px-1">{img.caption}</figcaption>}
        </figure>
      ))}
    </div>
  ) : images.length === 3 ? (
    <div class="grid md:grid-cols-2 gap-3 my-8">
      <figure class="img-framed md:row-span-2">
        <img src={images[0].src} alt={images[0].alt ?? ''} class="h-full object-cover" loading="lazy" />
      </figure>
      {images.slice(1).map((img) => (
        <figure class="img-framed">
          <img src={img.src} alt={img.alt ?? ''} loading="lazy" />
        </figure>
      ))}
    </div>
  ) : (
    <div class="grid sm:grid-cols-2 gap-3 my-8">
      {images.map((img) => (
        <figure class="img-framed">
          <img src={img.src} alt={img.alt ?? ''} loading="lazy" />
          {img.caption && <figcaption class="img-caption px-1">{img.caption}</figcaption>}
        </figure>
      ))}
    </div>
  )
}
