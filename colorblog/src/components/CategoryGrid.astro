---
import { site } from '../../site.config';
import { t, localePath, type Locale } from '../lib/locale';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = t(locale);

const colorMap: Record<string, string> = {
  sky: 'bg-sky text-white',
  mustard: 'bg-mustard text-forest',
  moss: 'bg-moss text-white',
  brick: 'bg-brick text-white',
  lilac: 'bg-lilac text-white',
};
---

<section class="container-page section-pad" data-assemble>
  <div class="flex items-end justify-between gap-4 mb-2">
    <h2 class="heading-lg">{ui.sections.categories}</h2>
    <p class="meta-text hidden sm:block">{ui.sections.categoriesHint}</p>
  </div>
  <div class="section-line">
    <div class="section-line__dots" aria-hidden="true"><span /><span /><span /><span /></div>
  </div>

  <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4" data-stagger data-assemble>
    {
      site.categories.map((cat) => {
        const catUi = ui.categories[cat.id];
        return (
          <a
            href={localePath(locale, cat.href)}
            class:list={[
              'group relative p-5 border-2 border-ink rounded-medium transition-transform duration-250 hover:-translate-y-1 hover:shadow-card',
              colorMap[cat.color] ?? 'bg-board',
            ]}
          >
            <span class="font-display text-3xl mb-3 block transition-transform group-hover:translate-x-1">
              {cat.icon}
            </span>
            <h3 class="font-display text-xl font-semibold mb-2">{catUi.label}</h3>
            <p class="text-sm opacity-90 leading-relaxed">{catUi.description}</p>
          </a>
        );
      })
    }
  </div>
</section>
