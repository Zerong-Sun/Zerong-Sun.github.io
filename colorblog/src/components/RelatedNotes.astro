---
import type { CollectionEntry } from 'astro:content';
import NoteCard from './NoteCard.astro';
import { t, type Locale } from '../lib/locale';

interface Props {
  notes: CollectionEntry<'notes'>[];
  locale?: Locale;
}

const { notes, locale = 'zh' } = Astro.props;
const ui = t(locale);
const variants = ['wood', 'sign', 'paper'] as const;
---

{
  notes.length > 0 && (
    <section class="my-12" data-assemble>
      <h2 class="heading-md mb-4">{ui.sections.related}</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {notes.map((note, i) => (
          <NoteCard note={note} variant={variants[i % 3]} locale={locale} />
        ))}
      </div>
    </section>
  )
}
