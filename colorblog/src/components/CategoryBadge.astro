---
import { site } from '../../site.config';
import { t, type Locale, type CategoryKey, isCategoryKey } from '../lib/locale';

interface Props {
  tag?: string;
  category?: CategoryKey;
  size?: 'sm' | 'md';
  locale?: Locale;
  /** Render as span when already inside another link (e.g. note cards). */
  static?: boolean;
}

const { tag, category, size = 'sm', locale = 'zh', static: isStatic = false } = Astro.props;
const ui = t(locale);

let href = '#';
let label = tag ?? '';
let color = 'moss';

if (category && isCategoryKey(category)) {
  href = locale === 'en' ? `/en/notes/category/${category}/` : `/notes/category/${category}/`;
  label = ui.categories[category].label;
  color = site.categories.find((c) => c.id === category)?.color ?? 'moss';
} else if (tag) {
  href = locale === 'en' ? `/en/notes/tags/${tag}/` : `/notes/tags/${tag}/`;
  label = tag;
  color = site.tagColors[tag] ?? 'moss';
}

const bg: Record<string, string> = {
  sky: 'bg-sky text-white',
  mustard: 'bg-mustard text-forest',
  moss: 'bg-moss text-white',
  lilac: 'bg-lilac text-white',
  brick: 'bg-brick text-white',
  teal: 'bg-teal text-forest',
  coral: 'bg-coral text-forest',
};
---

{
  isStatic ? (
    <span
      class:list={[
        'inline-flex items-center font-ui font-semibold border-2 border-ink rounded-small',
        size === 'sm' ? 'text-[11px] px-2 py-0.5' : 'text-xs px-2.5 py-1',
        bg[color] ?? 'bg-board text-ink',
      ]}
    >
      {label}
    </span>
  ) : (
    <a
      href={href}
      class:list={[
        'inline-flex items-center font-ui font-semibold border-2 border-ink rounded-small transition-transform hover:-translate-y-0.5',
        size === 'sm' ? 'text-[11px] px-2 py-0.5' : 'text-xs px-2.5 py-1',
        bg[color] ?? 'bg-board text-ink',
      ]}
    >
      {label}
    </a>
  )
}
