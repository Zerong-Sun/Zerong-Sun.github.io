---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/HomeHero.astro';
import NoteCard from '../components/NoteCard.astro';
import CategoryGrid from '../components/CategoryGrid.astro';
import PhotoStrip from '../components/PhotoStrip.astro';
import NowBoard from '../components/NowBoard.astro';
import { getAllNotes } from '../lib/notes';
import { t, localePath, type Locale } from '../lib/locale';

interface Props {
  locale?: Locale;
}

const locale: Locale = Astro.props.locale ?? 'zh';
const ui = t(locale);

const notes = await getAllNotes();
const recent = notes.slice(0, 5);
const featured = recent[0];
const side = recent.slice(1, 3);
const rest = recent.slice(3);
const variants = ['wood', 'sign', 'paper'] as const;
---

<BaseLayout locale={locale}>
  <HomeHero locale={locale} />

  <section class="container-page section-pad pt-0" data-assemble>
    <div class="flex items-end justify-between gap-4 mb-2">
      <h2 class="heading-lg">{ui.sections.recent}</h2>
      <a href={localePath(locale, '/notes/')} class="font-ui text-sm font-semibold text-sky hover:text-brick transition-colors">
        {ui.nav.allNotes} →
      </a>
    </div>
    <div class="section-line">
      <div class="section-line__dots" aria-hidden="true"><span /><span /><span /><span /></div>
    </div>

    {
      featured && (
        <div class="grid lg:grid-cols-3 gap-4 mb-4">
          <div class="lg:col-span-2">
            <NoteCard note={featured} variant="wood" featured locale={locale} />
          </div>
          <div class="flex flex-col gap-4">
            {side.map((note, i) => (
              <NoteCard note={note} variant={variants[(i + 1) % 3]} locale={locale} />
            ))}
          </div>
        </div>
      )
    }

    {
      rest.length > 0 && (
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 items-start">
          {rest.map((note, i) => (
            <NoteCard note={note} variant={variants[i % 3]} locale={locale} />
          ))}
        </div>
      )
    }
  </section>

  <CategoryGrid locale={locale} />
  <PhotoStrip locale={locale} />
  <NowBoard locale={locale} />
</BaseLayout>
