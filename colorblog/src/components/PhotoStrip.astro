---
import { site } from '../../site.config';
import { t, type Locale } from '../lib/locale';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = t(locale);

const borders = ['border-sky', 'border-brick', 'border-mustard', 'border-teal', 'border-moss', 'border-lilac'];
const widths = ['w-56', 'w-72', 'w-64', 'w-80', 'w-60', 'w-72'];
---

<section class="section-pad" data-assemble>
  <div class="container-page mb-4 flex items-end justify-between gap-4">
    <h2 class="heading-lg">{ui.sections.photoStrip}</h2>
    <p class="meta-text">{ui.sections.photoStripHint}</p>
  </div>

  <div
    class="flex gap-3 overflow-x-auto px-[max(1.25rem,calc((100%-var(--page-width))/2+1.25rem))] pb-4 cursor-grab active:cursor-grabbing select-none"
    data-photo-strip
    style="scroll-snap-type: x proximity; -webkit-overflow-scrolling: touch;"
  >
    {
      site.photos.map((photo, i) => (
        <figure
          class:list={[
            'relative shrink-0 border-[3px] border-forest bg-forest overflow-hidden group',
            borders[i % borders.length],
            widths[i % widths.length],
          ]}
          style="scroll-snap-align: start;"
        >
          <img
            src={photo.src}
            alt={photo.alt}
            class="h-44 md:h-52 w-full object-cover pointer-events-none"
            draggable="false"
            loading="lazy"
          />
          <figcaption class="absolute inset-x-0 bottom-0 translate-y-full group-hover:translate-y-0 transition-transform duration-250 bg-forest/90 text-paper px-3 py-2 font-ui text-xs flex justify-between gap-2">
            <span>{photo.location}</span>
            <span class="text-mustard">{photo.date}</span>
          </figcaption>
        </figure>
      ))
    }
  </div>
</section>

<style>
  [data-photo-strip].is-dragging { cursor: grabbing; }
  [data-photo-strip]::-webkit-scrollbar { height: 6px; }
  [data-photo-strip]::-webkit-scrollbar-thumb { background: var(--line); border-radius: 3px; }
</style>
