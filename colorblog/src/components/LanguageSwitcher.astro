---
import { switchLocalePath, t, type Locale } from '../lib/locale';

interface Props {
  locale: Locale;
  class?: string;
}

const { locale, class: className } = Astro.props;
const ui = t(locale);
const target = locale === 'zh' ? 'en' : 'zh';
const href = switchLocalePath(Astro.url.pathname, target);
---

<a
  href={href}
  class:list={[
    'inline-flex items-center justify-center min-w-[2.5rem] px-2 py-1 font-ui text-xs font-bold border-2 border-ink rounded-small bg-paper hover:bg-board transition-colors',
    className,
  ]}
  aria-label={locale === 'zh' ? 'Switch to English' : '切换到中文'}
>
  {ui.lang.switchTo}
</a>
