---
import RoadSignButton from './RoadSignButton.astro';
import { site } from '../../site.config';
import { t, localePath, type Locale } from '../lib/locale';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = t(locale);
---

<section class="container-page section-pad">
  <div class="grid gap-8 lg:grid-cols-[7fr_5fr] items-center">
    <div class="order-2 lg:order-1" data-assemble>
      <div class="photo-frame max-w-xl mx-auto lg:mx-0 relative">
        <span class="photo-frame__tape" aria-hidden="true" />
        <span class="photo-frame__bolt photo-frame__bolt--tl" aria-hidden="true" />
        <span class="photo-frame__bolt photo-frame__bolt--tr" aria-hidden="true" />
        <span class="photo-frame__bolt photo-frame__bolt--bl" aria-hidden="true" />
        <span class="photo-frame__bolt photo-frame__bolt--br" aria-hidden="true" />
        <img src={site.hero.photo} alt="" width="800" height="600" />
        <div class="absolute bottom-8 left-4 flex flex-wrap gap-2 z-10" data-assemble data-effect="stick" data-delay="2">
          <span class="metal-plate">{site.hero.date}</span>
          <span class="font-ui text-xs font-bold px-2 py-1 bg-brick text-white border border-ink rounded-small">
            ⌖ {site.hero.location}
          </span>
        </div>
      </div>
    </div>

    <div class="order-1 lg:order-2 space-y-5">
      <p class="heading-sub" data-assemble data-effect="stick" data-delay="1">{ui.hero.eyebrow}</p>
      <h1 class="heading-hero" data-assemble data-delay="2">
        <span class="hand-underline hand-underline--brick">{ui.hero.greeting}</span>
      </h1>
      <p class="text-lg md:text-xl text-ink-muted leading-relaxed max-w-md" data-assemble data-delay="3">
        {ui.hero.body}
      </p>
      <div class="flex flex-wrap gap-3 pt-2" data-assemble data-delay="4">
        <RoadSignButton href={localePath(locale, '/notes/')} label={ui.hero.ctaNotes} variant="brick" />
        <RoadSignButton href={localePath(locale, '/about/')} label={ui.hero.ctaAbout} variant="teal" />
      </div>
    </div>
  </div>
</section>
