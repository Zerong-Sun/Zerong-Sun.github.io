---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLocaleFromUrl, t } from '../lib/locale';

const locale = getLocaleFromUrl(Astro.url);
const ui = t(locale);
---

<BaseLayout title="404" locale={locale}>
  <section class="container-page section-pad text-center max-w-lg mx-auto">
    <p class="heading-sub mb-4">404</p>
    <h1 class="heading-xl mb-4">
      {locale === 'zh' ? '页面走丢了' : 'Page not found'}
    </h1>
    <p class="text-ink-muted mb-8 leading-relaxed">
      {
        locale === 'zh'
          ? '这条路牌指向的页面不存在，试试回到首页或浏览全部笔记。'
          : 'This sign points nowhere. Head back home or browse all notes.'
      }
    </p>
    <div class="flex flex-wrap justify-center gap-3">
      <a href={locale === 'en' ? '/en/' : '/'} class="sign-btn sign-btn--brick inline-flex">
        {ui.nav.home}
      </a>
      <a href={locale === 'en' ? '/en/notes/' : '/notes/'} class="sign-btn sign-btn--teal inline-flex">
        {ui.nav.allNotes}
      </a>
    </div>
  </section>
</BaseLayout>
