---
import { site } from '../../site.config.ts';

const { pathname } = Astro.url;

function isActive(href: string) {
  if (href === '/') return pathname === '/' || pathname === '';
  return pathname.startsWith(href);
}
---
<header class="sticky top-0 z-50 border-b border-[var(--border)] backdrop-blur-md" style="background: var(--nav-bg);">
  <nav class="mx-auto flex max-w-home items-center justify-between px-4 py-3 md:px-6">
    <a href="/" class="text-lg font-semibold tracking-tight text-[var(--text)] hover:text-primary">
      {site.title}
    </a>
    <ul class="flex flex-wrap items-center gap-1 md:gap-2">
      {site.nav.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={[
              'rounded-lg px-3 py-2 text-sm font-medium transition',
              isActive(item.href)
                ? 'bg-primary text-white'
                : 'text-[var(--text-secondary)] hover:bg-[var(--panel-bg)] hover:text-[var(--text)]',
            ]}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
