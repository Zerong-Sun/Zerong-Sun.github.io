---
import { site } from '../../site.config.ts';
import { getAllNotes } from '../lib/notes.ts';

const notes = await getAllNotes();
const start = new Date(site.footer.start);
---
<footer class="mt-16 border-t border-[var(--border)] py-8" style="background: var(--footer-bg);">
  <div class="mx-auto max-w-content px-4 text-center text-sm text-[var(--text-muted)] md:px-6">
    <p>
      © {new Date().getFullYear()} {site.author} · {notes.length} notes
    </p>
    <p class="mt-2" id="runtime"></p>
  </div>
</footer>
<script define:vars={{ startMs: start.getTime() }}>
  const el = document.getElementById('runtime');
  if (el) {
    const days = Math.floor((Date.now() - startMs) / 86400000);
    el.textContent = `Running ${days} days since Aug 17, 2022`;
  }
</script>
