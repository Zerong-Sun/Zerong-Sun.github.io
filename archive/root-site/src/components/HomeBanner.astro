---
import { site } from '../../site.config.ts';
---
<section
  class="home-banner relative min-h-[58vh] overflow-hidden border-b border-[var(--border)] bg-cover bg-center md:min-h-[72vh]"
  style={`--banner-light: url('${site.banner.images.light}'); --banner-dark: url('${site.banner.images.dark}');`}
>
  <div class="absolute inset-0 bg-gradient-to-b from-black/50 via-black/30 to-[var(--bg)] dark:from-black/60 dark:via-black/45"></div>
  <div class="relative mx-auto flex min-h-[58vh] max-w-home flex-col items-center justify-center px-4 py-16 text-center md:min-h-[72vh] md:px-6">
    <p class="mb-4 text-sm font-medium uppercase tracking-[0.2em] text-white/70">{site.author}</p>
    <h1 class="max-w-4xl text-3xl font-bold leading-tight text-white drop-shadow-lg md:text-5xl lg:text-[3.25rem]">
      {site.banner.title}
    </h1>
    <p id="banner-subtitle" class="banner-subtitle mt-5 max-w-2xl min-h-[3rem] text-base text-white/85 md:text-xl"></p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a
        href="/notes/"
        class="rounded-full bg-primary px-6 py-2.5 text-sm font-semibold text-white shadow-lg transition hover:brightness-110"
      >
        Browse Notes
      </a>
      <a
        href={`mailto:${site.social.email}`}
        class="rounded-full border border-white/35 px-5 py-2.5 text-sm text-white/90 backdrop-blur-sm transition hover:bg-white/10"
      >
        Email
      </a>
      <a
        href={site.social.rednote}
        target="_blank"
        rel="noopener"
        class="rounded-full border border-white/35 px-5 py-2.5 text-sm text-white/90 backdrop-blur-sm transition hover:bg-white/10"
      >
        RedNote
      </a>
    </div>
  </div>
  <a
    href="#recent-notes"
    class="absolute bottom-6 left-1/2 hidden -translate-x-1/2 text-white/50 transition hover:text-white/80 md:block"
    aria-label="Scroll to recent notes"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 5v14M19 12l-7 7-7-7"></path>
    </svg>
  </a>
</section>
<style>
  .home-banner {
    background-image: var(--banner-light);
  }
  html.dark .home-banner {
    background-image: var(--banner-dark);
  }
  .banner-subtitle {
    transition: opacity 0.4s ease;
  }
  .banner-subtitle.is-fading {
    opacity: 0;
  }
</style>
<script define:vars={{ subtitles: site.banner.subtitles }}>
  const el = document.getElementById('banner-subtitle');
  if (el && subtitles.length) {
    let i = 0;
    const show = () => {
      el.classList.add('is-fading');
      setTimeout(() => {
        el.textContent = subtitles[i % subtitles.length];
        el.classList.remove('is-fading');
        i += 1;
      }, 400);
    };
    el.textContent = subtitles[0];
    i = 1;
    setInterval(show, 4500);
  }
</script>
