---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeBanner from '../components/HomeBanner.astro';
import NoteCard from '../components/NoteCard.astro';
import { getAllNotes, getAllTags } from '../lib/notes.ts';

const notes = await getAllNotes();
const tags = await getAllTags();
const [featured, ...rest] = notes;
const recent = rest.slice(0, 5);
---
<BaseLayout>
  <HomeBanner />
  <section id="recent-notes" class="mx-auto max-w-home scroll-mt-20 px-4 py-10 md:px-6 md:py-14">
    <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h2 class="text-2xl font-bold text-[var(--text)] md:text-3xl">Recent Notes</h2>
        <p class="mt-1 text-sm text-[var(--text-secondary)]">
          {notes.length} essays · {tags.length} topics
        </p>
      </div>
      <a
        href="/notes/"
        class="inline-flex shrink-0 items-center gap-1 text-sm font-medium text-primary hover:underline"
      >
        View all
        <span aria-hidden="true">→</span>
      </a>
    </div>

    {featured && (
      <div class="mb-6">
        <NoteCard note={featured} featured />
      </div>
    )}

    {recent.length > 0 && (
      <div class="grid gap-5 md:grid-cols-2">
        {recent.map((note) => <NoteCard note={note} />)}
      </div>
    )}
  </section>
</BaseLayout>
