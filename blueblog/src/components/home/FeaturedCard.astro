---
interface Props {
  category: string;
  title: string;
  excerpt: string;
  date: string;
  readTime: string;
}

const { category, title, excerpt, date, readTime } = Astro.props;
---

<article
  class="block bg-paper-warm border border-pale-dust rounded-sm p-card-padding-lg
         transition-all duration-300 hover:border-durer hover:-translate-y-1 group cursor-pointer mx-auto max-w-wide"
>
  <span
    class="inline-block font-mono tracking-widest uppercase text-durer mb-3"
    style="font-size: var(--text-tag); letter-spacing: 0.1em;"
  >
    {category}
  </span>

  <h3 class="font-serif font-semibold text-ink mb-3 max-w-2xl" style="font-size: var(--text-section-title);">
    <a href="#" class="text-ink no-underline group-hover:text-prussian transition-colors duration-300">
      {title}
    </a>
  </h3>

  <p class="text-ink-soft mb-5 max-w-xl leading-relaxed line-clamp-2" style="font-size: var(--text-body);">
    {excerpt}
  </p>

  <div class="flex items-center justify-between font-mono text-ink-soft" style="font-size: var(--text-caption);">
    <span>{date}</span>
    <span class="flex items-center gap-4">
      <span>{readTime}</span>
      <span class="text-durer group-hover:text-prussian transition-colors duration-300">&rarr; Read</span>
    </span>
  </div>
</article>
