---
---

<section class="min-h-screen flex items-center pt-16">
  <div class="mx-auto max-w-content px-6 w-full">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-section items-center">

      <!-- Left: text -->
      <div class="md:col-span-5">
        <h1 class="font-serif font-semibold text-ink mb-6 leading-tight" style="font-size: var(--text-hero);">
          Shaun Cui
        </h1>

        <p class="font-sans text-ink-soft mb-4 tracking-wide" style="font-size: var(--text-body-sm);">
          Researcher &middot; Builder &middot; Founder
        </p>

        <p class="text-ink-soft mb-element-gap-lg max-w-md leading-relaxed" style="font-size: var(--text-body-sm);">
          Studying complex biological systems, and building the tools that turn research into something visible, usable, and lasting.
        </p>

        <div class="flex flex-wrap gap-3" style="margin-top: var(--element-gap-lg);">
          <a
            href="/research/"
            class="inline-flex items-center px-5 py-2.5 font-sans text-sm tracking-wider border text-durer border-durer rounded-sm
                   hover:bg-durer/10 transition-colors duration-300 no-underline"
          >
            Research
          </a>
          <a
            href="/ventures/"
            class="inline-flex items-center px-5 py-2.5 font-sans text-sm tracking-wider border text-durer border-durer rounded-sm
                   hover:bg-durer/10 transition-colors duration-300 no-underline"
          >
            Ventures
          </a>
        </div>
      </div>

      <!-- Right: framed visual -->
      <div class="md:col-span-7 flex justify-center md:justify-end">
        <div class="relative max-w-md w-full">
          <div
            class="aspect-[3/4] w-full flex items-center justify-center bg-deep-slate"
            style="
              border: 1px solid var(--color-durer-blue);
              outline: 1px solid var(--color-pale-dust);
              outline-offset: 3px;
            "
          >
            <div class="text-center text-pale-dust select-none">
              <p class="font-serif" style="font-size: var(--text-section-title);">Plate I</p>
              <p class="font-mono mt-2 tracking-widest uppercase" style="font-size: var(--text-tag);">Engraved Study</p>
            </div>
          </div>
          <p
            class="mt-4 text-right font-mono text-ink-soft"
            style="font-size: var(--text-caption);"
          >
            Fig. 1 &middot; Study, Work, and Construction
          </p>
        </div>
      </div>

    </div>
  </div>
</section>
