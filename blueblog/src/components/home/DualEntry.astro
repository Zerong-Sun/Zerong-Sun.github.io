---
const researchTags = [
  'comparative genomics',
  'single-cell analysis',
  'protein design',
  'biological systems',
];

const ventureTags = [
  'scientific tooling',
  'model evaluation',
  'platform design',
  'biotech venture building',
];
---

<section class="mx-auto max-w-wide px-6 py-section">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

    <!-- Research -->
    <a
      href="/research/"
      class="block bg-paper-warm border border-pale-dust rounded-sm p-card-padding-lg
             transition-all duration-300 hover:border-durer hover:-translate-y-1 no-underline group"
    >
      <h2 class="font-serif font-semibold text-ink mb-4" style="font-size: var(--text-section-title);">
        <span class="text-durer">&loz;</span> Research
      </h2>
      <div class="flex flex-wrap gap-2 mb-6">
        {researchTags.map((tag) => (
          <span
            class="inline-block font-mono text-ink-soft bg-paper border border-pale-dust rounded-sm px-2.5 py-1"
            style="font-size: var(--text-tag);"
          >
            {tag}
          </span>
        ))}
      </div>
      <span class="inline-flex items-center font-sans text-sm text-durer group-hover:text-prussian transition-colors duration-300">
        View Research &rarr;
      </span>
    </a>

    <!-- Ventures -->
    <a
      href="/ventures/"
      class="block bg-paper-warm border border-pale-dust rounded-sm p-card-padding-lg
             transition-all duration-300 hover:border-durer hover:-translate-y-1 no-underline group"
    >
      <h2 class="font-serif font-semibold text-ink mb-4" style="font-size: var(--text-section-title);">
        <span class="text-bronze">&loz;</span> Ventures
      </h2>
      <div class="flex flex-wrap gap-2 mb-6">
        {ventureTags.map((tag) => (
          <span
            class="inline-block font-mono text-ink-soft bg-paper border border-pale-dust rounded-sm px-2.5 py-1"
            style="font-size: var(--text-tag);"
          >
            {tag}
          </span>
        ))}
      </div>
      <span class="inline-flex items-center font-sans text-sm text-durer group-hover:text-prussian transition-colors duration-300">
        View Ventures &rarr;
      </span>
    </a>

  </div>
</section>
