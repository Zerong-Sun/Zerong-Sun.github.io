---
const entries = [
  { date: 'Jul 2026', text: 'Building a protein generation model evaluation framework.' },
  { date: 'Jul 2026', text: 'Comparative motif logic in regeneration-associated chromatin.' },
  { date: 'Jun 2026', text: 'Platform prototype phase: turning research workflows into tools.' },
];
---

<section class="mx-auto max-w-wide px-6 py-section">
  <h2 class="font-serif font-semibold text-ink mb-8" style="font-size: var(--text-section-title);">
    Now
  </h2>

  <ul class="space-y-3" role="list">
    {entries.map((entry) => (
      <li class="flex gap-4 items-baseline">
        <span
          class="shrink-0 font-mono text-ink-soft"
          style="font-size: var(--text-caption);"
        >
          {entry.date}
        </span>
        <span
          class="text-ink leading-relaxed"
          style="font-size: var(--text-body-sm);"
        >
          {entry.text}
        </span>
      </li>
    ))}
  </ul>
</section>
