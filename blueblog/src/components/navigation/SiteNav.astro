---
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/research/', label: 'Research' },
  { href: '/ventures/', label: 'Ventures' },
  { href: '/writing/', label: 'Writing' },
  { href: '/about/', label: 'About' },
  { href: '/archive/', label: 'Archive' },
];

const currentPath = Astro.url.pathname;
---

<nav class="fixed top-0 left-0 right-0 z-50">
  <div class="mx-auto max-w-content px-6">
    <div class="flex items-center justify-between h-16">
      <a
        href="/"
        class="font-serif text-lg text-ink no-underline hover:text-durer transition-colors duration-300"
      >
        SC
      </a>

      <ul class="hidden md:flex items-center gap-8" role="list">
        {navLinks.map((link) => {
          const isActive = currentPath === link.href;
          return (
            <li>
              <a
                href={link.href}
                class={`relative font-sans text-sm tracking-wider no-underline transition-colors duration-300 pb-1
                  ${isActive ? 'text-ink' : 'text-ink-soft hover:text-ink'}`}
              >
                {link.label}
                {isActive && (
                  <span class="absolute bottom-0 left-0 right-0 h-0.5 bg-durer"></span>
                )}
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </div>
</nav>
