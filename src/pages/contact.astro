---
import BaseLayout from '../layouts/BaseLayout.astro';
import FriendsGrid from '../components/FriendsGrid.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'contact');
if (!page) throw new Error('Missing contact page content');
const { Content } = await page.render();
---
<BaseLayout title={page.data.title}>
  <div class="mx-auto max-w-content px-4 py-10 md:px-6">
    <h1 class="mb-8 text-3xl font-bold text-[var(--text)]">{page.data.title}</h1>
    <div class="prose-note">
      <Content />
    </div>
    <FriendsGrid />
  </div>
</BaseLayout>
