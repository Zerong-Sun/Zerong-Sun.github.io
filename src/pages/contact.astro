---
import PageLayout from '../layouts/PageLayout.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'contact');
if (!page) throw new Error('Missing contact page content');
const { Content } = await page.render();
---
<PageLayout title={page.data.title}>
  <Content />
</PageLayout>
<style is:global>
  .links-content { width: 100%; max-width: none; margin: 2rem auto; }
  .links-content .link-navigation {
    --gap: 16px;
    display: flex !important;
    flex-wrap: wrap;
    gap: var(--gap);
    justify-content: center;
    margin-top: 1rem;
    padding: 0;
  }
  .links-content .card-link {
    flex: 0 0 calc(33% - (2 * var(--gap) / 4));
    max-width: calc(25% - (3 * var(--gap) / 4));
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .links-content .card {
    aspect-ratio: 1 / 1;
    width: 100%;
    background: var(--panel-bg);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    display: flex;
    flex-direction: column;
  }
  .links-content .card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
  }
  .links-content .ava {
    width: 100%;
    height: 65%;
    object-fit: contain;
    background: #fff;
    display: block;
  }
  .links-content .card-header {
    height: 35%;
    padding: 10px 12px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 0;
  }
  .links-content .card-header > div:first-child {
    font-size: 0.95rem;
    font-weight: 600;
    margin-bottom: 0.25rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .links-content .card-header .info {
    font-size: 0.78rem;
    line-height: 1.35;
    color: var(--text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  @media (max-width: 900px) {
    .links-content .card-link {
      flex-basis: calc(50% - (var(--gap) / 2));
      max-width: calc(50% - (var(--gap) / 2));
    }
  }
  @media (max-width: 520px) {
    .links-content .card-link { flex-basis: 100%; max-width: 100%; }
  }
</style>
