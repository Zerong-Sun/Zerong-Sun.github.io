---
import AboutLayout from '../layouts/AboutLayout.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'about');
if (!page) throw new Error('Missing about page content');
const { Content } = await page.render();
const { title, name, nameZh, tagline, summary } = page.data;
---
<AboutLayout {title} {name} {nameZh} {tagline} {summary}>
  <Content />
</AboutLayout>
