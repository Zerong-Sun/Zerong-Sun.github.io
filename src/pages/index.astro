---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeBanner from '../components/HomeBanner.astro';
import NoteCard from '../components/NoteCard.astro';
import { getAllNotes } from '../lib/notes.ts';

const notes = await getAllNotes();
const recent = notes.slice(0, 10);
---
<BaseLayout>
  <HomeBanner />
  <section class="mx-auto max-w-home px-4 py-12 md:px-6">
    <div class="mb-8 flex items-end justify-between gap-4">
      <h2 class="text-2xl font-bold text-[var(--text)]">Recent Notes</h2>
      <a href="/notes/" class="text-sm font-medium text-primary hover:underline">View all →</a>
    </div>
    <div class="grid gap-5 md:grid-cols-2">
      {recent.map((note) => <NoteCard note={note} />)}
    </div>
  </section>
</BaseLayout>
