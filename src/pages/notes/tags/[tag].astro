---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import NoteCard from '../../../components/NoteCard.astro';
import TagList from '../../../components/TagList.astro';
import { getAllNotes, getAllTags } from '../../../lib/notes.ts';

export async function getStaticPaths() {
  const tags = await getAllTags();
  return tags.map(({ tag }) => ({ params: { tag } }));
}

const tag = decodeURIComponent(Astro.params.tag ?? '');
const notes = (await getAllNotes()).filter((n) => n.data.tags.includes(tag));
const tags = await getAllTags();
---
<BaseLayout title={`Tag: ${tag}`}>
  <div class="mx-auto max-w-content px-4 py-10 md:px-6">
    <h1 class="mb-4 text-3xl font-bold text-[var(--text)]">Tag: {tag}</h1>
    <div class="mb-8"><TagList tags={tags} activeTag={tag} /></div>
    <div class="grid gap-5">
      {notes.map((note) => <NoteCard note={note} />)}
    </div>
  </div>
</BaseLayout>
