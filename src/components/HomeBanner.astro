---
import { site } from '../../site.config.ts';
---
<section
  class="home-banner relative min-h-[70vh] overflow-hidden border-b border-[var(--border)] bg-cover bg-center"
  style={`--banner-light: url('${site.banner.images.light}'); --banner-dark: url('${site.banner.images.dark}');`}
>
  <div class="absolute inset-0 bg-black/25 dark:bg-black/45"></div>
  <div class="relative mx-auto flex min-h-[70vh] max-w-home flex-col items-center justify-center px-6 text-center">
    <h1 class="max-w-4xl text-3xl font-bold leading-tight text-white drop-shadow md:text-5xl">
      {site.banner.title}
    </h1>
    <p id="banner-subtitle" class="mt-5 min-h-[2rem] text-lg text-white/90 md:text-2xl"></p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-4 text-sm text-white/90">
      <a href={`mailto:${site.social.email}`} class="rounded-full border border-white/30 px-4 py-2 hover:bg-white/10">Email</a>
      <a href={site.social.rednote} target="_blank" rel="noopener" class="rounded-full border border-white/30 px-4 py-2 hover:bg-white/10">RedNote</a>
    </div>
  </div>
</section>
<style>
  .home-banner {
    background-image: var(--banner-light);
  }
  html.dark .home-banner {
    background-image: var(--banner-dark);
  }
</style>
<script define:vars={{ subtitles: site.banner.subtitles }}>
  const el = document.getElementById('banner-subtitle');
  if (el && subtitles.length) {
    let i = 0;
    const show = () => {
      el.textContent = subtitles[i % subtitles.length];
      i += 1;
    };
    show();
    setInterval(show, 4000);
  }
</script>
