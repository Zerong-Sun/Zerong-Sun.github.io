---
interface Props {
  tags: { tag: string; count: number }[];
  activeTag?: string;
}

const { tags, activeTag } = Astro.props;
---
<div class="flex flex-wrap gap-2">
  <a href="/notes/" class:list={['tag-chip', !activeTag && 'ring-2 ring-primary']}>All</a>
  {tags.map(({ tag, count }) => (
    <a
      href={`/notes/tags/${encodeURIComponent(tag)}/`}
      class:list={['tag-chip', activeTag === tag && 'ring-2 ring-primary']}
    >
      {tag} ({count})
    </a>
  ))}
</div>
