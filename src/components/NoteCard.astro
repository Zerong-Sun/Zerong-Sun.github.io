---
import type { Note } from '../lib/notes.ts';
import { excerpt, formatDate, readingTime } from '../lib/notes.ts';

interface Props {
  note: Note;
  showExcerpt?: boolean;
  featured?: boolean;
}

const { note, showExcerpt = true, featured = false } = Astro.props;
const { title, date, tags, description } = note.data;
const noteSlug = note.slug;
const summary = description ?? excerpt(note.body, featured ? 280 : 160);
const minutes = readingTime(note.body);
---
<article class:list={['note-card', featured && 'note-card--featured']}>
  <a href={`/notes/${noteSlug}/`} class="block space-y-3 no-underline">
    <div class="space-y-2">
      <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-[var(--text-muted)]">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        <span aria-hidden="true">·</span>
        <span>{minutes} min read</span>
      </div>
      {tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5">
          {tags.slice(0, featured ? 6 : 4).map((tag) => (
            <span class="tag-chip pointer-events-none">{tag}</span>
          ))}
        </div>
      )}
    </div>
    <h2 class:list={['font-semibold text-[var(--text)]', featured ? 'text-2xl md:text-3xl' : 'text-xl']}>
      {title}
    </h2>
    {showExcerpt && summary && (
      <p
        class:list={[
          'leading-relaxed text-[var(--text-secondary)]',
          featured ? 'line-clamp-4 text-base' : 'line-clamp-3 text-sm',
        ]}
      >
        {summary}
      </p>
    )}
    <span class="inline-flex items-center gap-1 text-sm font-medium text-primary">
      Read more
      <span aria-hidden="true">→</span>
    </span>
  </a>
</article>
