---
import BaseLayout from './BaseLayout.astro';
import { site } from '../../site.config.ts';

interface Props {
  title: string;
  description?: string;
  name?: string;
  nameZh?: string;
  tagline?: string;
  summary?: string;
}

const { title, description, name, nameZh, tagline, summary } = Astro.props;
const hasProfile = Boolean(name);
---

<BaseLayout title={title} description={description}>
  <div class="mx-auto max-w-content px-4 py-10 md:px-6">
    <h1 class="mb-6 text-3xl font-bold text-[var(--text)]">{title}</h1>

    {hasProfile && (
      <header class="about-profile mb-10 rounded-2xl border border-[var(--border)] p-6 md:p-8">
        <div class="flex flex-col gap-6 md:flex-row md:items-start md:justify-between">
          <div class="min-w-0">
            <h2 class="text-2xl font-bold tracking-tight text-[var(--text)] md:text-3xl">
              {name}
              {nameZh && (
                <span class="ml-2 text-xl font-medium text-[var(--text-secondary)] md:text-2xl">
                  {nameZh}
                </span>
              )}
            </h2>
            {tagline && (
              <p class="mt-2 text-sm font-medium uppercase tracking-wider text-primary md:text-base">
                {tagline}
              </p>
            )}
            {summary && (
              <p class="mt-4 max-w-2xl text-base leading-relaxed text-[var(--text-secondary)]">
                {summary}
              </p>
            )}
          </div>
          <div class="flex shrink-0 flex-wrap gap-2 md:justify-end">
            <a
              href={`mailto:${site.social.email}`}
              class="about-link-chip"
            >
              Email
            </a>
            <a
              href="https://github.com/Zerong-Sun"
              target="_blank"
              rel="noopener"
              class="about-link-chip"
            >
              GitHub
            </a>
            <a
              href={site.url}
              target="_blank"
              rel="noopener"
              class="about-link-chip"
            >
              Website
            </a>
          </div>
        </div>
      </header>
    )}

    <div class="prose-note prose-about">
      <slot />
    </div>
  </div>
</BaseLayout>
