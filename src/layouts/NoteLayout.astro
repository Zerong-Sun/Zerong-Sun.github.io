---
import BaseLayout from './BaseLayout.astro';
import ArticleToc from '../components/ArticleToc.astro';
import ArticleNav from '../components/ArticleNav.astro';
import type { Note } from '../lib/notes.ts';
import { formatDate, getAdjacentNotes, getAllNotes, readingTime } from '../lib/notes.ts';

interface Props {
  note: Note;
}

const { note } = Astro.props;
const { title, date, tags, description } = note.data;
const { Content, headings } = await note.render();
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const allNotes = await getAllNotes();
const { prev, next } = getAdjacentNotes(allNotes, note.slug);
const minutes = readingTime(note.body);
---
<BaseLayout title={title} description={description}>
  <div class="mx-auto max-w-content px-4 py-8 md:px-6 md:py-10">
    <a
      href="/notes/"
      class="mb-6 inline-flex items-center gap-1.5 text-sm text-[var(--text-muted)] hover:text-primary"
    >
      <span aria-hidden="true">←</span>
      All notes
    </a>

    <article>
      <header class="mb-8 border-b border-[var(--border)] pb-8">
        <div class="mb-4 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-[var(--text-muted)]">
          <time datetime={date.toISOString()}>{formatDate(date)}</time>
          <span aria-hidden="true">·</span>
          <span>{minutes} min read</span>
        </div>
        <h1 class="text-3xl font-bold leading-tight tracking-tight text-[var(--text)] md:text-4xl lg:text-[2.75rem] lg:leading-[1.15]">
          {title}
        </h1>
        {description && (
          <p class="mt-4 max-w-3xl text-lg leading-relaxed text-[var(--text-secondary)]">{description}</p>
        )}
        {tags.length > 0 && (
          <div class="mt-5 flex flex-wrap gap-2">
            {tags.map((tag) => (
              <a href={`/notes/tags/${encodeURIComponent(tag)}/`} class="tag-chip">{tag}</a>
            ))}
          </div>
        )}
      </header>

      {toc.length > 0 && <ArticleToc items={toc} variant="mobile" />}

      <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_220px]">
        <div class="prose-note min-w-0">
          <Content />
        </div>
        {toc.length > 0 && <ArticleToc items={toc} variant="sidebar" />}
      </div>

      <ArticleNav prev={prev} next={next} />
    </article>
  </div>
</BaseLayout>
